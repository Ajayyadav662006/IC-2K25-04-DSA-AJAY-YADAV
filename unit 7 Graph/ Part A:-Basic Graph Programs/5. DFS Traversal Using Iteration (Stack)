#include <iostream>
#include <vector>
#include <stack>
using namespace std;

int main()
{
    int n, e, u, v, start;

    cout << "Enter vertices: ";
    cin >> n;

    vector<int> adj[10];
    bool visited[10] = {false};

    cout << "Enter edges: ";
    cin >> e;

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    stack<int> s;
    s.push(start);

    cout << "DFS Traversal: ";

    while(!s.empty())
    {
        int node = s.top();
        s.pop();

        if(!visited[node])
        {
            visited[node] = true;
            cout << node << " ";

            for(int i = adj[node].size() - 1; i >= 0; i--)
            {
                if(!visited[adj[node][i]])
                    s.push(adj[node][i]);
            }
        }
    }

    return 0;
}
