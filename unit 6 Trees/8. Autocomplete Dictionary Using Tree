
#include <iostream>
#include <string>
using namespace std;

struct TrieNode {
    TrieNode* children[26];
    bool isEnd;

    TrieNode() {
        isEnd = false;

        for (int i = 0; i < 26; i++)
            children[i] = NULL;
    }
};

// Insert word
void insert(TrieNode* root, string word) {
    TrieNode* current = root;

    for (char ch : word) {
        int index = ch - 'a';

        if (current->children[index] == NULL)
            current->children[index] = new TrieNode();

        current = current->children[index];
    }

    current->isEnd = true;
}

// Search word
bool search(TrieNode* root, string word) {
    TrieNode* current = root;

    for (char ch : word) {
        int index = ch - 'a';

        if (current->children[index] == NULL)
            return false;

        current = current->children[index];
    }

    return current->isEnd;
}

// Display suggestions
void suggestions(TrieNode* root, string prefix) {
    if (root == NULL) return;

    if (root->isEnd)
        cout << prefix << endl;

    for (int i = 0; i < 26; i++) {
        if (root->children[i] != NULL) {
            char ch = 'a' + i;

            suggestions(root->children[i],
                        prefix + ch);
        }
    }
}

// Autocomplete function
void autocomplete(TrieNode* root, string prefix) {
    TrieNode* current = root;

    for (char ch : prefix) {
        int index = ch - 'a';

        if (current->children[index] == NULL) {
            cout << "No suggestions found";
            return;
        }

        current = current->children[index];
    }

    suggestions(current, prefix);
}

int main() {
    TrieNode* root = new TrieNode();

    insert(root, "apple");
    insert(root, "application");
    insert(root, "apply");
    insert(root, "banana");

    cout << "Search apple: ";

    if (search(root, "apple"))
        cout << "Found";
    else
        cout << "Not Found";

    cout << "\n\nAutocomplete for 'app':\n";

    autocomplete(root, "app");

    return 0;
}
