
#include <iostream>
#include <string>
using namespace std;

const int SIZE = 10;

class HashTable {
    string chain[SIZE][SIZE];
    int count[SIZE];

    string linear[SIZE];

    int hashFunction(string key) {
        int sum = 0;

        for (char c : key)
            sum += c;

        return sum % SIZE;
    }

public:
    HashTable() {
        for (int i = 0; i < SIZE; i++)
            count[i] = 0;
    }

    void chainingInsert(string key) {
        int index = hashFunction(key);

        if (count[index] == SIZE) {
            cout << "Chain Full\n";
            return;
        }

        chain[index][count[index]++] = key;
    }

    void linearInsert(string key) {
        int index = hashFunction(key);

        for (int i = 0; i < SIZE; i++) {
            int pos = (index + i) % SIZE;

            if (linear[pos] == "") {
                linear[pos] = key;
                return;
            }
        }

        cout << "Hash Table Full\n";
    }

    void displayChaining() {
        cout << "\nSeparate Chaining:\n";

        for (int i = 0; i < SIZE; i++) {
            cout << i << ": ";

            for (int j = 0; j < count[i]; j++)
                cout << chain[i][j] << " -> ";

            cout << "NULL\n";
        }
    }

    void displayLinear() {
        cout << "\nLinear Probing:\n";

        for (int i = 0; i < SIZE; i++)
            cout << i << ": " << linear[i] << endl;
    }
};

int main() {
    HashTable h1, h2;

    string words[] = {
        "cat", "act", "dog", "bat", "ant"
    };

    for (string word : words) {
        h1.chainingInsert(word);
        h2.linearInsert(word);
    }

    h1.displayChaining();
    h2.displayLinear();

    return 0;
}
