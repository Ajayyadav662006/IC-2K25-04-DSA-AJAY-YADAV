#include <iostream>
#include <vector>
#include <queue>
#include <climits>
#include <algorithm>
using namespace std;

int main()
{
    int n, e, u, v, w, source, dest;

    cout << "Enter number of cities: ";
    cin >> n;

    vector<pair<int,int>> adj[10];

    cout << "Enter number of routes: ";
    cin >> e;

    cout << "Enter routes (city1 city2 distance):\n";

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v >> w;
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    cout << "Enter source and destination: ";
    cin >> source >> dest;

    vector<int> dist(n, INT_MAX);
    vector<int> parent(n, -1);

    priority_queue<pair<int,int>,
        vector<pair<int,int>>,
        greater<pair<int,int>>> pq;

    dist[source] = 0;
    pq.push({0, source});

    while(!pq.empty())
    {
        int d = pq.top().first;
        int node = pq.top().second;
        pq.pop();

        if(d != dist[node])
            continue;

        for(auto x : adj[node])
        {
            int next = x.first;
            int weight = x.second;

            if(dist[node] + weight < dist[next])
            {
                dist[next] = dist[node] + weight;
                parent[next] = node;
                pq.push({dist[next], next});
            }
        }
    }

    if(dist[dest] == INT_MAX)
    {
        cout << "No route found";
        return 0;
    }

    cout << "\nShortest Distance: " << dist[dest];

    vector<int> path;

    for(int x = dest; x != -1; x = parent[x])
        path.push_back(x);

    reverse(path.begin(), path.end());

    cout << "\nShortest Route: ";

    for(int x : path)
        cout << x << " ";

    return 0;
}
