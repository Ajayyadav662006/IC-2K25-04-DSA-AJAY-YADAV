#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

int main()
{
    int n, e, u, v, w, source;

    cout << "Enter vertices and edges: ";
    cin >> n >> e;

    vector<pair<int,int>> adj[10];

    cout << "Enter edges (u v weight):\n";

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v >> w;
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    cout << "Enter source: ";
    cin >> source;

    vector<int> dist(n, INT_MAX);

    priority_queue<pair<int,int>,
        vector<pair<int,int>>,
        greater<pair<int,int>>> pq;

    dist[source] = 0;
    pq.push({0, source});

    while(!pq.empty())
    {
        int d = pq.top().first;
        int node = pq.top().second;
        pq.pop();

        if(d != dist[node])
            continue;

        for(auto x : adj[node])
        {
            int next = x.first;
            int weight = x.second;

            if(dist[node] + weight < dist[next])
            {
                dist[next] = dist[node] + weight;
                pq.push({dist[next], next});
            }
        }
    }

    cout << "\nShortest Distances:\n";

    for(int i = 0; i < n; i++)
    {
        cout << source << " to " << i << " = ";
        if(dist[i] == INT_MAX)
            cout << "Unreachable";
        else
            cout << dist[i];
        cout << endl;
    }

    return 0;
}
