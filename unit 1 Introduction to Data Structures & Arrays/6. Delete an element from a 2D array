#include <iostream>
using namespace std;

int main() {
    int a[10][10], r, c, x, y;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter matrix elements:\n";
    for(int i = 0; i < r; i++)
        for(int j = 0; j < c; j++)
            cin >> a[i][j];

    cout << "Enter position to delete: ";
    cin >> x >> y;

    if(x < 1 || x > r || y < 1 || y > c) {
        cout << "Invalid position";
        return 0;
    }

    a[x-1][y-1] = 0;

    cout << "Matrix after deletion:\n";
    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++)
            cout << a[i][j] << " ";
        cout << endl;
    }

    return 0;
}
