
#include <iostream>
using namespace std;

class PriorityQueue {
    int data[10], priority[10];
    int size;

public:
    PriorityQueue() {
        size = 0;
    }

    void enqueue(int x, int p) {
        if (size == 10) {
            cout << "Queue Full\n";
            return;
        }

        data[size] = x;
        priority[size] = p;
        size++;

        cout << x << " inserted\n";
    }

    void dequeue() {
        if (size == 0) {
            cout << "Queue Empty\n";
            return;
        }

        int pos = 0;

        for (int i = 1; i < size; i++) {
            if (priority[i] < priority[pos])
                pos = i;
        }

        cout << "Deleted: " << data[pos]
             << " (Priority " << priority[pos] << ")\n";

        for (int i = pos; i < size - 1; i++) {
            data[i] = data[i + 1];
            priority[i] = priority[i + 1];
        }

        size--;
    }

    void display() {
        cout << "Priority Queue:\n";

        for (int i = 0; i < size; i++) {
            cout << data[i] << " Priority: "
                 << priority[i] << endl;
        }
    }
};

int main() {
    PriorityQueue q;

    q.enqueue(100, 3);
    q.enqueue(200, 1);
    q.enqueue(300, 2);

    q.display();

    q.dequeue();

    q.display();

    return 0;
}

