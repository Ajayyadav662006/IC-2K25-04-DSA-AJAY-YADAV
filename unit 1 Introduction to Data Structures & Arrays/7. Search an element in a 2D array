#include <iostream>
using namespace std;

int main() {
    int a[10][10], r, c, key, found = 0;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter matrix elements:\n";
    for(int i = 0; i < r; i++)
        for(int j = 0; j < c; j++)
            cin >> a[i][j];

    cout << "Enter element to search: ";
    cin >> key;

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            if(a[i][j] == key) {
                cout << "Found at row " << i+1
                     << " column " << j+1;
                found = 1;
            }
        }
    }

    if(!found)
        cout << "Element not found";

    return 0;
}
