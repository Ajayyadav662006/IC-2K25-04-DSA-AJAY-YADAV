#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main()
{
    int n, e, u, v;

    cout << "Enter number of courses: ";
    cin >> n;

    vector<int> adj[10];
    int indegree[10] = {0};

    cout << "Enter prerequisites (u v):\n";

    for(int i = 0; i < e; i++)
    {
        // This loop is replaced below after reading e.
    }

    cout << "Enter number of prerequisites: ";
    cin >> e;

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        indegree[v]++;
    }

    queue<int> q;

    for(int i = 0; i < n; i++)
    {
        if(indegree[i] == 0)
            q.push(i);
    }

    cout << "Course Order: ";

    int count = 0;

    while(!q.empty())
    {
        int node = q.front();
        q.pop();

        cout << node << " ";
        count++;

        for(int x : adj[node])
        {
            indegree[x]--;

            if(indegree[x] == 0)
                q.push(x);
        }
    }

    if(count != n)
        cout << "\nCycle detected! No valid course order.";

    return 0;
}
