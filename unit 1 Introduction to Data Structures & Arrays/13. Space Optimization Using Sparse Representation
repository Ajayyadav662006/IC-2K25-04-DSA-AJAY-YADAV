#include <iostream>
using namespace std;

int main() {
    int a[10][10], r, c, count = 0;

    cout << "Enter rows and columns: ";
    cin >> r >> c;

    cout << "Enter matrix elements:\n";

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < c; j++) {
            cin >> a[i][j];

            if(a[i][j] != 0)
                count++;
        }
    }

    int total = r * c;

    cout << "\nTotal elements: " << total;
    cout << "\nNon-zero elements: " << count;

    cout << "\nNormal matrix memory: "
         << total * sizeof(int) << " bytes";

    cout << "\nSparse matrix memory: "
         << (count + 1) * 3 * sizeof(int) << " bytes";

    if((count + 1) * 3 < total)
        cout << "\nSparse representation saves memory.";
    else
        cout << "\nSparse representation does not save memory.";

    return 0;
}
