
#include <iostream>
#include <queue>
using namespace std;

int main() {
    priority_queue<
        pair<int, int>,
        vector<pair<int, int>>,
        greater<pair<int, int>>
    > pq;

    // First value = priority
    // Second value = data

    pq.push({3, 100});
    pq.push({1, 200});
    pq.push({2, 300});

    cout << "Priority Queue:\n";

    while (!pq.empty()) {
        cout << "Data: " << pq.top().second
             << " Priority: " << pq.top().first
             << endl;

        pq.pop();
    }

    return 0;
}

Output:-
Priority Queue:
Data: 200 Priority: 1
Data: 300 Priority: 2
Data: 100 Priority: 3