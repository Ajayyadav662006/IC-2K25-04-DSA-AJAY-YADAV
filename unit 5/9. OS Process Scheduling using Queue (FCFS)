
#include <iostream>
#include <queue>
using namespace std;

int main() {
    queue<int> q;

    int n, process;

    cout << "Enter number of processes: ";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        cout << "Enter Process ID: ";
        cin >> process;

        q.push(process);
    }

    cout << "\nProcess Execution Order:\n";

    while (!q.empty()) {
        cout << "Process P"
             << q.front()
             << " is executing\n";

        q.pop();
    }

    cout << "All processes completed\n";

    return 0;
}

