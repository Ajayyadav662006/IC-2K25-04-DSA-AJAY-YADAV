#include <iostream>
using namespace std;

#define MAX 5 // Maximum capacity of the stack

class Stack {
    int top;
    int arr[MAX]; // Array to store stack elements

public:
    // Constructor initializes top to -1 (indicating empty stack)
    Stack() { 
        top = -1; 
    }

    // Insert an element onto the stack
    bool push(int x) {
        if (top >= (MAX - 1)) {
            cout << "Stack Overflow! Cannot push " << x << endl;
            return false;
        }
        arr[++top] = x;
        cout << x << " pushed into stack\n";
        return true;
    }

    // Remove the top element from the stack
    int pop() {
        if (top < 0) {
            cout << "Stack Underflow! No elements to pop\n";
            return 0;
        }
        int x = arr[top--];
        return x;
    }

    // View the topmost element without removing it
    int peek() {
        if (top < 0) {
            cout << "Stack is Empty\n";
            return 0;
        }
        return arr[top];
    }

    // Check if the stack is completely empty
    bool isEmpty() {
        return (top < 0);
    }
};

int main() {
    Stack s;
    
    // Push elements onto the stack
    s.push(10);
    s.push(20);
    s.push(30);

    // View the top element
    cout << "Top element is: " << s.peek() << endl;

    // Pop elements from the stack
    cout << s.pop() << " popped from stack\n";
    cout << s.pop() << " popped from stack\n";

    // Check if the stack is empty
    if (s.isEmpty()) {
        cout << "The stack is empty.\n";
    } else {
        cout << "The stack is not empty. Top is: " << s.peek() << endl;
    }

    return 0;
}
