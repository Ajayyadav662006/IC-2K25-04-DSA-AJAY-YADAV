#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> adj[10];
bool visited[10];

void DFS(int node)
{
    visited[node] = true;
    cout << node << " ";

    for(int x : adj[node])
        if(!visited[x])
            DFS(x);
}

void BFS(int start, int n)
{
    fill(visited, visited + n, false);

    queue<int> q;
    q.push(start);
    visited[start] = true;

    while(!q.empty())
    {
        int node = q.front();
        q.pop();

        cout << node << " ";

        for(int x : adj[node])
        {
            if(!visited[x])
            {
                visited[x] = true;
                q.push(x);
            }
        }
    }
}

int main()
{
    int n, e, u, v;

    cout << "Enter vertices and edges: ";
    cin >> n >> e;

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "BFS: ";
    BFS(0, n);

    fill(visited, visited + n, false);

    cout << "\nDFS: ";
    DFS(0);

    return 0;
}
