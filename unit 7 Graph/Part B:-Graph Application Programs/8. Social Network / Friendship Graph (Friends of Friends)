#include <iostream>
#include <vector>
#include <set>
using namespace std;

int main()
{
    int n, e, u, v, person;

    cout << "Enter number of persons: ";
    cin >> n;

    vector<int> adj[10];

    cout << "Enter number of friendships: ";
    cin >> e;

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter person: ";
    cin >> person;

    set<int> direct, friendsOfFriends;

    for(int x : adj[person])
        direct.insert(x);

    for(int x : direct)
    {
        for(int y : adj[x])
        {
            if(y != person && direct.find(y) == direct.end())
                friendsOfFriends.insert(y);
        }
    }

    cout << "Direct Friends: ";
    for(int x : direct)
        cout << x << " ";

    cout << "\nFriends of Friends: ";
    for(int x : friendsOfFriends)
        cout << x << " ";

    return 0;
}
