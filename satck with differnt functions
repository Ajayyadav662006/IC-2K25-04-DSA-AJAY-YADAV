#include<iostream>
#include<stack>
using namespace std;
int main(){
    stack<int>s;
    s.push(30);
    s.push(40);
    s.push(50);
    s.push(60);
    s.push(70);
    s.push(80);
    cout<<"Current stack size: "<<s.size()<<endl;
    cout<<"Top element: "<<s.top()<<endl;
    s.pop();
    cout<<"Top element after one pop: "<<s.top()<<endl;
    if(s.empty()){
        cout<<"Stack is empty."<<endl;
    }else{
        cout<<"Stack is not empty."<<endl;
    }
    return 0;


}
