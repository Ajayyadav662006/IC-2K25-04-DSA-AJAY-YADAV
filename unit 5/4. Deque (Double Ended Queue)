
#include <iostream>
#include <deque>
using namespace std;

int main() {
    deque<int> dq;

    dq.push_front(10);
    dq.push_back(20);
    dq.push_front(5);
    dq.push_back(30);

    cout << "Deque: ";

    for (int x : dq)
        cout << x << " ";

    cout << "\n";

    dq.pop_front();
    dq.pop_back();

    cout << "After deletion: ";

    for (int x : dq)
        cout << x << " ";

    cout << endl;

    return 0;
}
 
Output:-
Deque: 5 10 20 30
After deletion: 10 20