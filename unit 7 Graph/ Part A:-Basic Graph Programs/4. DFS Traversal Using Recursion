#include <iostream>
#include <vector>
using namespace std;

vector<int> adj[10];
bool visited[10] = {false};

void DFS(int node)
{
    visited[node] = true;
    cout << node << " ";

    for(int x : adj[node])
    {
        if(!visited[x])
            DFS(x);
    }
}

int main()
{
    int n, e, u, v, start;

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> e;

    for(int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "DFS Traversal: ";
    DFS(start);

    return 0;
}
