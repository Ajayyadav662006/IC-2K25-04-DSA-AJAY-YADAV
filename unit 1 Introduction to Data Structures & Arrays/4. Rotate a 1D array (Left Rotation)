#include <iostream>
using namespace std;

int main() {
    int a[100], n, k;

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Enter rotations: ";
    cin >> k;

    k = k % n;

    for(int j = 0; j < k; j++) {
        int first = a[0];

        for(int i = 0; i < n-1; i++)
            a[i] = a[i+1];

        a[n-1] = first;
    }

    cout << "Rotated array: ";
    for(int i = 0; i < n; i++)
        cout << a[i] << " ";

    return 0;
}
